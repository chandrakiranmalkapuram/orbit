{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBIT",
  "version": "0.1.0",
  "identifier": "app.orbit.fileutility",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ORBIT",
        "width": 820,
        "height": 820,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Utility",
    "shortDescription": "Private offline file utility",
    "longDescription": "Floating offline desktop orb for instant file conversions and safe extractions on macOS.",
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
